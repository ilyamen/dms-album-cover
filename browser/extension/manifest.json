{
  "manifest_version": 3,
  "name": "DMS Album Cover",
  "version": "1.0.0",
  "description": "Passes the full-size cover of the playing track (navigator.mediaSession) to the Album Cover widget of DankMaterialShell. Nothing leaves the computer.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_idle" }
  ]
}
